# AquaWatch Application Settings
PROJECT_NAME="AquaWatch API"
ENVIRONMENT="development"
DEBUG=true

# Database Settings
# For local development:
DATABASE_URL="sqlite:///./data/aquawatch.db"

# CORS Configuration
# Comma-separated list of allowed origins or regex pattern for Vercel
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
CORS_ORIGIN_REGEX="https://.*\.vercel\.app"

# Production Environment Variables (Render Dashboard > Environment):
# PYTHON_VERSION=3.11.9
# ENVIRONMENT=production
# DEBUG=false
# CORS_ORIGINS=https://aquawatch.vercel.app,http://localhost:5173
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
